# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Service role key (solo server-side: webhooks, jobs). NEVER en código cliente.
# https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (live keys from the Stripe dashboard)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Signing secret del webhook (/api/webhooks/stripe) — dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Origin del sitio para success/cancel URLs del checkout y return del Portal
NEXT_PUBLIC_APP_URL=https://www.offplaninternational.com

# Stripe price IDs por tier de pago — dashboard.stripe.com/products
# Developer: starter/pro/enterprise
DEVELOPER_STARTER_PRICE_ID=price_xxx
DEVELOPER_PRO_PRICE_ID=price_xxx
DEVELOPER_ENTERPRISE_PRICE_ID=price_xxx
# Broker: starter/pro/enterprise
BROKER_STARTER_PRICE_ID=price_xxx
BROKER_PRO_PRICE_ID=price_xxx
BROKER_ENTERPRISE_PRICE_ID=price_xxx
# Private Seller: single/starter/pro
PRIVATE_SINGLE_PRICE_ID=price_xxx
PRIVATE_STARTER_PRICE_ID=price_xxx
PRIVATE_PRO_PRICE_ID=price_xxx